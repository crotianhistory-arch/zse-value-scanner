# Core scanner
# ZSE_DATA_DIR=./data
# Optional separate large research warehouse; default: $ZSE_DATA_DIR/warehouse
# ZSE_WAREHOUSE_DIR=/data/zse-research
# ZSE_MIN_REQUEST_INTERVAL=1.0

# Optional Ollama fallback. Default is OFF.
ZSE_USE_LLM=0
ZSE_LLM_PROVIDER=ollama
ZSE_OLLAMA_URL=http://127.0.0.1:11434
ZSE_OLLAMA_AUTOSTART=1
ZSE_LLM_REQUIRE_GPU=1

# Model selection: auto = choose the largest installed model that fits the
# conservative VRAM budget and then verify it is 100% GPU with `ollama ps`.
ZSE_OLLAMA_MODEL=auto
# Optional comma-separated allowlist. Leave empty to consider installed
# non-embedding models.
# ZSE_OLLAMA_MODELS=qwen3:8b,gemma3:4b

# Optional NVIDIA GPU index. Empty = GPU with most currently-free VRAM.
# ZSE_OLLAMA_GPU=0

# Keep headroom for context/KV cache and other GPU allocations.
ZSE_LLM_VRAM_RESERVE_GIB=1.25
ZSE_LLM_MAX_VRAM_FRACTION=0.90
ZSE_LLM_CONTEXT=2048
ZSE_LLM_KEEP_ALIVE=5m
ZSE_LLM_MAPPING_CONFIDENCE=0.95
ZSE_OLLAMA_FLASH_ATTENTION=1
